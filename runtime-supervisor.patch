diff --git a/src/runtime_outcome.hpp b/src/runtime_outcome.hpp
new file mode 100644
--- /dev/null
+++ b/src/runtime_outcome.hpp
@@ -0,0 +1,38 @@
+#pragma once
+#include <string>
+#include <vector>
+
+enum class RuntimeOutcome { COMPLETED, PARTIAL_SUCCESS, RETRYABLE, NEEDS_USER, EXTERNAL_UNAVAILABLE, FAILED, CANCELLED };
+enum class RuntimeCause { NONE, LLM_TIMEOUT, LLM_RATE_LIMIT, LLM_AUTH_ERROR, LLM_PROVIDER_ERROR,
+    LLM_INVALID_RESPONSE, BROWSER_TIMEOUT, STALE_ELEMENT, NO_STATE_CHANGE, AUTH_REQUIRED,
+    TARGET_NOT_FOUND, ALREADY_EXISTS, ACCESS_DENIED, VALIDATION_ERROR, ITERATION_LIMIT, INVALID_PLAN, UNKNOWN };
+inline const char* outcomeName(RuntimeOutcome value) {
+    switch (value) {
+#define OUTCOME_CASE(v) case RuntimeOutcome::v: return #v;
+        OUTCOME_CASE(COMPLETED) OUTCOME_CASE(PARTIAL_SUCCESS) OUTCOME_CASE(RETRYABLE)
+        OUTCOME_CASE(NEEDS_USER) OUTCOME_CASE(EXTERNAL_UNAVAILABLE) OUTCOME_CASE(FAILED) OUTCOME_CASE(CANCELLED)
+#undef OUTCOME_CASE
+    }
+    return "FAILED";
+}
+inline const char* causeName(RuntimeCause value) {
+    switch (value) {
+#define CAUSE_CASE(v) case RuntimeCause::v: return #v;
+        CAUSE_CASE(NONE) CAUSE_CASE(LLM_TIMEOUT) CAUSE_CASE(LLM_RATE_LIMIT) CAUSE_CASE(LLM_AUTH_ERROR)
+        CAUSE_CASE(LLM_PROVIDER_ERROR) CAUSE_CASE(LLM_INVALID_RESPONSE) CAUSE_CASE(BROWSER_TIMEOUT)
+        CAUSE_CASE(STALE_ELEMENT) CAUSE_CASE(NO_STATE_CHANGE) CAUSE_CASE(AUTH_REQUIRED)
+        CAUSE_CASE(TARGET_NOT_FOUND) CAUSE_CASE(ALREADY_EXISTS) CAUSE_CASE(ACCESS_DENIED)
+        CAUSE_CASE(VALIDATION_ERROR) CAUSE_CASE(ITERATION_LIMIT) CAUSE_CASE(INVALID_PLAN) CAUSE_CASE(UNKNOWN)
+#undef CAUSE_CASE
+    }
+    return "UNKNOWN";
+}
+struct TaskResult {
+    RuntimeOutcome outcome = RuntimeOutcome::FAILED;
+    RuntimeCause cause = RuntimeCause::UNKNOWN;
+    std::string message;
+    std::vector<std::string> verifiedProgress;
+    std::string blockedStage;
+    std::string lastExecutionIssue;
+    std::string recovery;
+};
