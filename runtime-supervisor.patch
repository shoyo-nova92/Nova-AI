+    check("ITERATION_LIMIT_IS_TYPED",!limit.success && limit.cause==RuntimeCause::ITERATION_LIMIT && inspections==12);
+    std::error_code ec;
+    fs::remove_all(root,ec);
+    check("FIXTURE_CLEANED",!ec && !fs::exists(root));
+    std::cout << "Passed: " << checks-failures << " Failed: " << failures << '\n';
+    return failures ? 1 : 0;
+}
