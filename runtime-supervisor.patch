+namespace {
+RuntimeCause llmCause(LLMFailureCategory failure) {
+    switch (failure) {
+        case LLMFailureCategory::TIMEOUT: return RuntimeCause::LLM_TIMEOUT;
+        case LLMFailureCategory::RATE_LIMIT: return RuntimeCause::LLM_RATE_LIMIT;
+        case LLMFailureCategory::AUTH_ERROR: return RuntimeCause::LLM_AUTH_ERROR;
+        case LLMFailureCategory::INVALID_RESPONSE: return RuntimeCause::LLM_INVALID_RESPONSE;
+        default: return RuntimeCause::LLM_PROVIDER_ERROR;
+    }
+}
+bool transient(LLMFailureCategory failure) {
+    return failure == LLMFailureCategory::TIMEOUT || failure == LLMFailureCategory::RATE_LIMIT ||
+        failure == LLMFailureCategory::PROVIDER_ERROR || failure == LLMFailureCategory::CONNECTION_ERROR;
+}
+RuntimeCause executionCause(const std::string& category) {
+    if (category == "stale_element") return RuntimeCause::STALE_ELEMENT;
+    if (category == "browser_timeout") return RuntimeCause::BROWSER_TIMEOUT;
+    if (category == "auth_required") return RuntimeCause::AUTH_REQUIRED;
+    if (category == "target_not_found" || category == "not_found") return RuntimeCause::TARGET_NOT_FOUND;
+    if (category == "already_exists") return RuntimeCause::ALREADY_EXISTS;
+    if (category == "access_denied" || category == "protected_location") return RuntimeCause::ACCESS_DENIED;
+    return RuntimeCause::UNKNOWN;
+}
+bool matchesPostcondition(const MultiStepAction& step, const PrimitiveOperation& operation,
+                          const ExecutionResult& evidence) {
+    if (step.postconditionKind.empty() || !evidence.postconditionVerified ||
+        step.postconditionKind != evidence.verifiedKind || evidence.resolvedPath.empty()) return false;
+    if (step.postconditionKind == "directory_exists" && operation.name != "filesystem.create") return false;
+    if (step.postconditionKind == "file_content" && operation.name != "filesystem.create_file") return false;
+    if (step.contentRequirement == "required" &&
+        operation.parameters.content.find_first_not_of(" \t\r\n") == std::string::npos) return false;
+    auto path = std::filesystem::path(evidence.resolvedPath);
+    if (path.filename().empty()) path = path.parent_path();
+    if (lower(path.filename().string()) != lower(step.artifactName)) return false;
+    // Reuse the existing destination-clue guard; no new path resolution here.
+    return locationContainsExpectedTokens(path.parent_path().string(),
+        expectedParentLocationTokens("artifact at " + step.artifactLocation + "/" + step.artifactName));
+}
