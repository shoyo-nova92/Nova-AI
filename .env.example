# Copy to .env and supply your own OpenRouter key.
OPENROUTER_API_KEY=

# Optional: override the built-in model with an available OpenRouter model ID.
# NOVA_MODEL=
# NOVA_FALLBACK_MODEL=

# Disable spoken replies for the initial text-only setup.
NOVA_TTS_ENABLED=0

# Optional IANA timezone override; otherwise read config/personal_sources.json.
# NOVA_TIMEZONE=Etc/UTC

# Optional Notion integration: share the relevant pages with this integration.
# NOTION_API_KEY=

# Optional Twilio voice calls. Disabled unless explicitly enabled.
NOVA_CALLS_ENABLED=0
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# NOVA_PHONE_TO=
